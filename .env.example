# ── Обов'язкові ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Для локального запуску (без Docker): localhost:8001 (зовнішній порт)
# Для Docker: значення нижче НЕ використовуються — compose задає їх сам
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Моделі ────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
LLM_MODEL=gpt-4o-mini

# ── Бот ───────────────────────────────────────────────────────────────────────
# Для локального запуску бота (без Docker):
API_BASE_URL=http://localhost:8000

# ── Оновлення даних ───────────────────────────────────────────────────────────
# Інтервал автоматичного оновлення правових документів (години)
DATA_UPDATE_INTERVAL_HOURS=24
